/validate:
    summary: Validate test
    test: make -C ../.. validate
    require:
        - cargo
        - clippy
        - go-md2man
        - make
        - protobuf-compiler
        - rustfmt
    adjust:
        enabled: false
        when: initiator is not defined or initiator != packit

/unit:
    summary: Unit tests
    test: make -C ../.. unit
    require:
        - cargo
        - make
        - protobuf-compiler
    adjust:
        enabled: false
        when: initiator is not defined or initiator != packit

/integration:
    summary: Integration tests
    test: bash integration.sh
    environment:
        NETAVARK: /usr/libexec/podman/netavark
        NETAVARK_CONNECTION_TESTER: /usr/bin/netavark-connection-tester
        NETAVARK_DHCP_PROXY_CLIENT: /usr/libexec/podman/netavark-dhcp-proxy-client
        TEST_PLUGINS: /usr/share/netavark/examples
    require:
        - aardvark-dns
        - netavark
        - netavark-tests
    duration: 10m

/podman:
    summary: Podman tests dependent on netavark
    test: |
        /usr/bin/bats -t /usr/share/podman/test/system/030-run.bats
        /usr/bin/bats -t /usr/share/podman/test/system/075-exec.bats
        /usr/bin/bats -t /usr/share/podman/test/system/500-networking.bats
    require:
        - podman-tests
    duration: 15m

/musl:
    summary: MUSL build check
    test: |
        podman run --rm -v $(pwd)/../..:/src:Z -w /src docker.io/library/alpine:latest \
            sh -c '. /etc/os-release && [ "$NAME" = "Alpine Linux" ] || { echo "Not running on Alpine Linux (NAME=$NAME) - musl check requires the alpine container image"; exit 1; }; apk add --no-cache cargo build-base protobuf && cargo build'
    require:
        - podman
    adjust:
        enabled: false
        when: initiator is not defined or initiator != packit
